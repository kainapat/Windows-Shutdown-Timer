    {
      "dot": "rose",
      "title": "Scheduling rules",
      "items": [
        "Shutdown / Restart validate a future target and cap scheduling at 72 hours.",
        "Any existing Windows shutdown task is aborted before a new one is scheduled."
      ]
    },
    {
      "dot": "cyan",
      "title": "Immediate power path",
      "items": [
        "Sleep / Hibernate branch before Timer or Clock validation.",
        "After confirmation, rundll32 invokes powrprof SetSuspendState immediately."
      ]
    },
    {
      "dot": "violet",
      "title": "Persistence",
      "items": [
        "Timer selections are loaded from JSON on startup.",
        "Writes use a temporary file followed by os.replace for atomic persistence."
      ]
    }

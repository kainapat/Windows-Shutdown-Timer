  "cards": [
    {
      "dot": "rose",
      "title": "Scheduling rules",
      "items": [
        "Shutdown / Restart require a future, non-zero target and are capped at 72 hours.",
        "The app attempts shutdown /a before scheduling a new Windows shutdown or restart."
      ]
    },
    {
      "dot": "cyan",
      "title": "Immediate power path",
      "items": [
        "Sleep / Hibernate branch before Timer or Clock validation.",
        "After confirmation, rundll32 invokes powrprof SetSuspendState immediately."
      ]
    },
    {
      "dot": "violet",
      "title": "Persistence",
      "items": [
        "Startup loads window settings and timer selections from separate JSON files.",
        "Writes use temporary files followed by os.replace for atomic replacement."
      ]
    }
  ]
